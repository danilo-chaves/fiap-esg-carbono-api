# ==========================================
# Variáveis de Ambiente - Carbono API (ESG)
# ==========================================
# Copie este arquivo para .env e altere os valores conforme o ambiente.
# Exemplo: cp .env.example .env

# Banco de Dados Oracle
ORACLE_PASSWORD=sua_senha_oracle_aqui
APP_USER=usuario_aplicacao
APP_USER_PASSWORD=senha_usuario_aplicacao
ORACLE_PORT=1521

# Aplicação Spring Boot
APP_PORT=8080
JWT_SECRET=coloque_uma_chave_secreta_com_pelo_menos_256_bits_aqui
JWT_EXPIRATION_MS=86400000

# Docker Registry (CI/CD)
DOCKERHUB_USERNAME=seu_usuario_dockerhub
DOCKERHUB_REPO=carbono-api
